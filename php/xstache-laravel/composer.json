{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dirk/xstache-laravel",
    "description": "",
    "license": "BSD-2-Clause",
    "repositories": [
        {
            "type": "path",
            "url": "../xstache"
        }
    ],
    "require": {
        "php": ">=8.0",
        "dirk/xstache": "*@dev",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phan/phan": "^6.0",
        "php-coveralls/php-coveralls": "^2.6",
        "phpunit/phpunit": ">=7",
        "spatie/phpunit-snapshot-assertions": "^5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Xstache\\Laravel\\": "src/"
        }
    },
    "config": {
        "policy": {
            "cooldown": {
                "period": "7 days",
                "ignore": {
                    "dirk/*": ""
                }
            }
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xstache\\Laravel\\ServiceProvider"
            ]
        }
    }
}
